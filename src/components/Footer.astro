---
const version = __APP_VERSION__;
const build = new Date(__BUILD_TIME__);
const human = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
  timeZone: "Asia/Tokyo",
}).format(build);
import "../styles/global.css";
import {
  FOOTER_COPYRIGHT,
  FOOTER_SOURCE_LABEL,
  FOOTER_SOURCE_URL,
  WHY_SNAILS_BODY,
  WHY_SNAILS_HEADING,
} from "../data/siteFooter";
---

<footer>
  <div class="footer-content">
    <div class="copy-right">
      <p>{FOOTER_COPYRIGHT}</p>
    </div>
    <div class="site-info">
      <p>
        <a
          href={FOOTER_SOURCE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="link--underline link--external">{FOOTER_SOURCE_LABEL}</a
        >
      </p>
    </div>
  </div>
  <section class="why-snails">
    <div class="why-snail-c">
      <h2>{WHY_SNAILS_HEADING}</h2>
      <p>
        {WHY_SNAILS_BODY}
      </p>
    </div>
  </section>
</footer>

<style>
  footer {
    border-top: 1px solid #545454;
    font-family: var(--base-fonts-sans);
    margin-top: 2rem;
    margin-bottom: 2rem;
    padding-left: 10px;
    padding-right: 10px;

    /* flex-wrap: wrap; */
    gap: 1rem;

    .footer-content {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      /* align-items: center; */
    }

    .why-snails {
      display: flex;
      justify-content: flex-start;

      .why-snail-c {
        /* width: 75%; */
        h2 {
          margin-top: 0;
          font-size: 1rem;
        }
        p {
          font-size: 0.8rem;
          text-wrap: pretty;
        }
      }
    }
  }
  @media (max-width: 640px) {
    footer {
      .footer-content {
        gap: 0.2rem;
      }
    }
  }
</style>
