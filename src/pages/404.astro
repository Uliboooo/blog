---
// src/pages/404.astro
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="404 Not Found - Compute on Snails"
  description="Page not found"
>
  <div class="not-found">
    <p class="code">404</p>
    <h2>Page Not Found.</h2>
    <p class="message">このURLの記事は失くしちゃったみたい。</p>
    <!-- <p class="message">ごめんね</p> -->
    <a href="/" class="home-link">⇐ Home</a>
    <img src="/404.png" alt="404 image" id="charactor" />
  </div>
</MainLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4rem 1rem;
    gap: 0.5rem;
  }

  #charactor {
    width: 60%;
  }

  @media (max-width: 640px) {
    #charactor {
      width: 100%;
    }
  }

  .code {
    font-size: 5rem;
    font-weight: 700;
    margin: 0;
    color: #da70d6;
    line-height: 1;
  }

  h2 {
    margin: 0.5rem 0 0;
    font-size: 1.6rem;
  }

  .message {
    color: #666;
    margin: 0.5rem 0 1.5rem;
  }

  :root.dark .message {
    color: #b0b0b0;
  }

  .home-link {
    color: var(--link-color);
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 600;
    background-image: linear-gradient(#da70d6, #da70d6);
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 0 1px;
    transition: background-size 0.3s ease-in-out;
    padding-bottom: 1px;
  }

  .home-link:hover {
    color: #da70d6;
    background-size: 100% 1.5px;
  }
</style>
