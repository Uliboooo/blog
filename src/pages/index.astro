---
// src/pages/index.astro
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import externalJson from "../data/external.json";

const postsP = getCollection("blog");

const external = externalJson as ExternalPost[];

type ExternalPost = {
  id: string;
  title: string;
  date: string;
  url: string;
  description?: string;
  tags: string[];
  published: boolean;
};

type BlogItem = {
  id: string;
  data: {
    title: string;
    date: Date;
    description?: string;
    tags?: string[];
    published?: boolean;
    url?: string;
  };
};

const externalPosts: BlogItem[] = external.map((item) => ({
  id: item.url,
  data: {
    title: item.title,
    date: new Date(item.date),
    description: item.description?.trim() || undefined,
    tags: item.tags,
    published: true,
    url: item.url,
  },
}));

const posts = await postsP;
const astroPosts: BlogItem[] = posts.map((post) => ({
  id: post.id,
  data: {
    title: post.data.title,
    date: post.data.date,
    description: post.data.description?.trim() || undefined,
    tags: post.data.tags,
    published: post.data.published,
    url: `/${post.id.split("/")[0]}`,
  },
}));

const sorted = [...astroPosts, ...externalPosts]
  .filter((post) => post.data.published !== false)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<MainLayout
  title="Compute on Snails"
  description="Compute on Snails"
  ogImage="/og/index.png"
>
  <h2>Articles</h2>
  <ul class="article-list">
    {sorted.map(post => (
      <li class="article-item">
        <a href={post.data.url} class="article-title">{post.data.title}</a>

        {post.data.description && (
          <p class="article-description">{post.data.description}</p>
        )}

        <div class="article-meta">
          <time>
            {post.data.date.toLocaleDateString('ja-JP')}
          </time>

          {post.data.tags?.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </li>
    ))}
  </ul>
</MainLayout>

<script is:inline>
  (() => {
    // ── vim-like list navigation (j/k focus, Enter opens) ──
    const items = Array.from(document.querySelectorAll('.article-title'));
    if (items.length === 0) return;

    let index = -1;
    items.forEach((item, i) => {
      item.addEventListener('focus', () => {
        index = i;
      });
    });

    const isTypingTarget = (el) =>
      el instanceof HTMLElement &&
      (el.isContentEditable ||
        ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName));

    // Same continuously-eased scroll used on article pages, so rapid/held
    // j/k presses chase a single moving target instead of each keypress
    // firing its own competing `scrollIntoView(smooth)` animation.
    const SCROLL_PADDING = 24;
    let targetY = null;
    let rafId = null;

    const maxScroll = () =>
      document.documentElement.scrollHeight - window.innerHeight;
    const clamp = (v) => Math.max(0, Math.min(v, maxScroll()));

    const animate = () => {
      const current = window.scrollY;
      const diff = targetY - current;
      if (Math.abs(diff) < 1) {
        window.scrollTo(0, targetY);
        rafId = null;
        targetY = null;
        return;
      }
      window.scrollTo(0, current + diff * 0.3);
      rafId = requestAnimationFrame(animate);
    };

    const setTarget = (y) => {
      targetY = clamp(y);
      if (rafId === null) rafId = requestAnimationFrame(animate);
    };

    const focusIndex = (i) => {
      index = Math.max(0, Math.min(i, items.length - 1));
      const item = items[index];
      item.focus({ preventScroll: true });

      const rect = item.getBoundingClientRect();
      const itemTop = rect.top + window.scrollY;
      const itemBottom = itemTop + rect.height;
      const visibleTop = targetY ?? window.scrollY;
      const visibleBottom = visibleTop + window.innerHeight;

      if (itemTop < visibleTop + SCROLL_PADDING) {
        setTarget(itemTop - SCROLL_PADDING);
      } else if (itemBottom > visibleBottom - SCROLL_PADDING) {
        setTarget(itemBottom - window.innerHeight + SCROLL_PADDING);
      }
    };

    document.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (isTypingTarget(e.target)) return;

      switch (e.key) {
        case 'j':
          focusIndex(index + 1);
          break;
        case 'k':
          focusIndex(index - 1);
          break;
        default:
          return;
      }

      e.preventDefault();
    });
  })();
</script>

<style>
  h2 {
    font-size: 1.8rem;
  }

  .article-list {
    list-style: none;
    padding: 0;
    padding-left: 1rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .article-title {
    color: var(--link-color);
    text-decoration: none;
    font-size: 1.4rem;
    background-image: linear-gradient(#da70d6, #da70d6);
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 0 1px;
    transition: background-size 0.3s ease-in-out;
    padding-bottom: 1px;
    font-weight: 600;
  }

  .article-title:hover {
    color: #da70d6;
    background-size: 100% 1.5px;
  }

  .article-title:focus-visible {
    outline: 2px solid #da70d6;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .article-description {
    margin: 0.35rem 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #555;
  }

  :root.dark .article-description {
    color: #B0B0B0;
  }

  .article-meta {
    display: flex;
    grid-area: 1rem;
    font-size: 0.9rem;
    color: #666;
    white-space: nowrap;
    margin-top: 0.25rem;
  }

  .article-meta::before {
    content: "—";
    margin-left: 1.3rem;
  }

  time {
    color: #666;
    font-size: 0.9rem;
    margin-left: 0.2rem;
  }

  .tags {
    display: inline-flex;
    gap: 0.4rem;
    margin-left: 0.5rem;
  }

  .tag {
    display: inline-block;
    color: #333;
    font-size: 0.9rem;
    margin-left: 0.4rem;
  }

  .tag::before {
    content: "#";
    color: #666;
    margin-right: 0.15rem;
  }

  :root.dark .tag {
    color: #D1D1D1;
  }

  :root.dark .tag::before {
    content: "#";
    color: #B0B0B0;
    margin-right: 0.15rem;
  }
</style>
