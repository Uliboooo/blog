---
// src/pages/search.astro
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Search - Compute on Snails" description="記事を検索">
  <h2>Search</h2>
  <div id="search" data-pagefind-ignore="all"></div>
  <p id="search-fallback" hidden>
    検索インデックスが見つからない。インデックスはビルド時に生成されるので、
    <code>bun run build</code>のあと<code>bun run preview</code>で確認する。
  </p>
</MainLayout>

<script>
  import { PagefindUI } from "@pagefind/default-ui";
  import "@pagefind/default-ui/css/ui.css";

  const mount = document.getElementById("search");
  const fallback = document.getElementById("search-fallback");

  // インデックスは`pagefind --site dist`で生成されるため`astro dev`には存在しない。
  // 本番でpagefindの実行が失敗した場合にも壊れた検索窓を出さないようにする。
  const available = await fetch("/pagefind/pagefind-entry.json", {
    method: "HEAD",
  })
    .then((res) => res.ok)
    .catch(() => false);

  if (!available) {
    if (mount) mount.hidden = true;
    if (fallback) fallback.hidden = false;
  } else {
    const initial = new URLSearchParams(location.search).get("q")?.trim() ?? "";

    const ui = new PagefindUI({
      element: "#search",
      bundlePath: "/pagefind/",
      pageSize: 10,
      showImages: false,
      showSubResults: true,
      showEmptyFilters: false,
      openFilters: ["tag"],
      excerptLength: 30,
      autofocus: !initial,
      // j/kで結果へ移動したあと"/"で検索窓に戻れるようにする。
      focusOnSlash: true,
      // 見出しへのサブ結果は、深さがわかるようにmarkdown記法を前置する
      // (h2 -> "## foo")。process_resultはサブ結果の描画前に呼ばれ、
      // titleはプレーンテキストとして出力されるためここで加工できる。
      processResult: (data) => {
        for (const sub of data.sub_results ?? []) {
          const level = /^h([1-6])$/.exec(sub.anchor?.element ?? "")?.[1];
          if (level) sub.title = `${"#".repeat(Number(level))} ${sub.title}`;
        }
        return data;
      },
      // 日本語UI文字列は<html lang="ja">から自動で読み込まれる。
      // ここではこのサイト固有の言い回しだけ上書きする。
      translations: {
        placeholder: "記事を検索",
        filters_label: "タグで絞り込み",
      },
    });

    // 検索結果は別タブで開く。結果のDOMはPagefindが実行時に作るので、
    // 追加されたリンクにその都度target/relを付与する。clickを横取りすると
    // 中クリックやCtrl+クリックの挙動が壊れるため、属性で対応する。
    if (mount) {
      const markExternal = () => {
        const links = mount.querySelectorAll<HTMLAnchorElement>(
          "a.pagefind-ui__result-link:not([target])",
        );
        for (const link of links) {
          link.target = "_blank";
          link.rel = "noopener noreferrer";
        }
      };
      new MutationObserver(markExternal).observe(mount, {
        childList: true,
        subtree: true,
      });
      markExternal();
    }

    // ── vim-like list navigation (j/k focus, Enter opens) ──
    // index.astroと同じ操作感。ただし検索結果は実行時に差し替わるので、
    // 要素を保持せず毎回DOMから取り直し、現在位置はactiveElementから求める。
    const SCROLL_PADDING = 24;
    let targetY: number | null = null;
    let rafId: number | null = null;

    const maxScroll = () =>
      document.documentElement.scrollHeight - window.innerHeight;
    const clamp = (v: number) => Math.max(0, Math.min(v, maxScroll()));

    // 連打・長押しでもアニメーションが競合しないよう、単一の目標値を追う
    // (index.astro / BlogPost.astroと同じ方式)。
    const animate = () => {
      if (targetY === null) return;
      const current = window.scrollY;
      const diff = targetY - current;
      if (Math.abs(diff) < 1) {
        window.scrollTo(0, targetY);
        rafId = null;
        targetY = null;
        return;
      }
      window.scrollTo(0, current + diff * 0.3);
      rafId = requestAnimationFrame(animate);
    };

    const setTarget = (y: number) => {
      targetY = clamp(y);
      if (rafId === null) rafId = requestAnimationFrame(animate);
    };

    // 移動対象は記事タイトルと配下の見出し(サブ結果)。DOM順にそのまま並べる。
    const navLinks = () =>
      Array.from(
        mount?.querySelectorAll<HTMLAnchorElement>(
          "a.pagefind-ui__result-link",
        ) ?? [],
      );

    // 結果は再描画されるので、現在位置は都度activeElementから求める。
    const currentIndex = (links: HTMLAnchorElement[]) =>
      links.indexOf(document.activeElement as HTMLAnchorElement);

    const focusIndex = (links: HTMLAnchorElement[], i: number) => {
      const link = links[Math.max(0, Math.min(i, links.length - 1))];
      if (!link) return;
      link.focus({ preventScroll: true });

      // スクロールはリンク1行ではなくブロック単位で合わせる。見出しなら
      // その見出しブロック、記事タイトルなら記事全体を基準にする。
      const box =
        link.closest<HTMLElement>(".pagefind-ui__result-nested") ??
        link.closest<HTMLElement>("li.pagefind-ui__result") ??
        link;
      const rect = box.getBoundingClientRect();
      const top = rect.top + window.scrollY;
      const bottom = top + rect.height;
      const visibleTop = targetY ?? window.scrollY;
      const visibleBottom = visibleTop + window.innerHeight;

      if (top < visibleTop + SCROLL_PADDING) {
        setTarget(top - SCROLL_PADDING);
      } else if (bottom > visibleBottom - SCROLL_PADDING) {
        // 画面より高い記事は先頭を上端に合わせる
        setTarget(
          rect.height + SCROLL_PADDING * 2 > window.innerHeight
            ? top - SCROLL_PADDING
            : bottom - window.innerHeight + SCROLL_PADDING,
        );
      }
    };

    const isTypingTarget = (el: EventTarget | null) =>
      el instanceof HTMLElement &&
      (el.isContentEditable ||
        ["INPUT", "TEXTAREA", "SELECT"].includes(el.tagName));

    // captureで拾う。Pagefindの入力欄はEscapeで「検索語を消して」blurするが、
    // それだと結果が消えてj/kで辿れない。ここで止めて、Escapeは
    // 「入力欄から抜けるだけ(検索語は残す)」に変える。消したいときはクリアボタン。
    document.addEventListener(
      "keydown",
      (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;

        if (e.key === "Escape" && isTypingTarget(e.target)) {
          (e.target as HTMLElement).blur();
          e.stopPropagation();
          e.preventDefault();
          return;
        }
        if (isTypingTarget(e.target)) return;
        if (e.key !== "j" && e.key !== "k") return;

        const links = navLinks();
        if (links.length === 0) return;

        const current = currentIndex(links);
        focusIndex(links, e.key === "j" ? current + 1 : current - 1);
        e.preventDefault();
      },
      true,
    );

    // /search?q=... で検索結果を直接開けるようにする。
    if (initial) ui.triggerSearch(initial);

    // 入力に合わせて?q=を書き換え、結果をそのまま共有できるようにする。
    // pushStateではなくreplaceStateなので戻る操作で検索が再実行されない。
    const input = mount?.querySelector<HTMLInputElement>(
      "input.pagefind-ui__search-input",
    );
    let timer: ReturnType<typeof setTimeout>;
    input?.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        const url = new URL(location.href);
        const value = input.value.trim();
        if (value) url.searchParams.set("q", value);
        else url.searchParams.delete("q");
        history.replaceState(null, "", url);
      }, 400);
    });
  }
</script>

<style>
  #search-fallback {
    color: var(--text-muted);
    font-size: 0.9rem;
    border-left: 2px solid var(--line-color);
    padding-left: 0.75rem;
  }
</style>

<style is:global>
  /* PagefindのDOMは実行時生成なのでAstroのスコープCSSでは当たらない。
     ライブラリ側の規則は.svelte-xxxx付きで詳細度が高いため、#searchを
     前置してIDで勝つ。変数はglobal.cssの:root/:root.darkに繋ぐだけで
     ライト/ダーク両対応になる。 */
  #search {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--text);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--line-color);
    --pagefind-ui-tag: var(--table-stripe-bg);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: var(--base-fonts-sans);
  }

  #search .pagefind-ui__search-input {
    font-weight: 500; /* ライブラリ既定の700は日本語だと太すぎる */
  }

  /* ライブラリ既定のopacity:0.2はコントラスト不足 */
  #search .pagefind-ui__search-input::placeholder {
    color: var(--text-muted);
    opacity: 0.75;
  }

  #search .pagefind-ui__search-input:focus-visible,
  #search .pagefind-ui__search-clear:focus-visible,
  #search .pagefind-ui__button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  #search .pagefind-ui__search-clear {
    background-color: transparent;
    color: var(--text-muted);
  }

  #search .pagefind-ui__result-link {
    color: var(--a-link);
  }

  /* j/kでの移動先を示す。index.astroの.article-titleと同じ見た目。
     :focus-visibleはプログラム的focus()だとブラウザの判定次第で出ないため、
     ここは:focusで確実に表示する。 */
  #search .pagefind-ui__result-link:focus {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* フォーカス中の記事ブロックも薄く示して、どこにいるか分かるようにする。 */
  #search li.pagefind-ui__result:focus-within {
    background-color: var(--table-stripe-bg);
    border-radius: var(--pagefind-ui-border-radius);
  }

  #search .pagefind-ui__result-excerpt {
    color: var(--text);
    line-height: 1.7;
  }

  #search .pagefind-ui__result-tag {
    color: var(--tag-text);
  }

  /* リセットが`mark { all: revert }`を当てるのでブラウザ既定の黄色になる。
     Rules/color-design.mdに従い新しい色は足さず、既存の--accentの下線で示す。 */
  #search mark {
    background: none;
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 2px;
  }

  /* タグ欄はflex:1(結果側はflex:1000)なので実質min-widthで幅が決まる。
     既定の260pxは本文幅750pxに対して広すぎるため詰める。 */
  #search .pagefind-ui__filter-panel {
    min-width: min(calc(150px * var(--pagefind-ui-scale)), 100%);
  }

  #search .pagefind-ui__drawer {
    gap: calc(32px * var(--pagefind-ui-scale));
  }

  #search .pagefind-ui__filter-name {
    color: var(--heading-color);
  }

  #search .pagefind-ui__filter-value {
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    #search {
      --pagefind-ui-scale: 0.85;
    }

    /* タグ欄を詰めた分、横並びのまま収まる幅が下がった。
       狭い画面では明示的に縦積みにする。 */
    #search .pagefind-ui__drawer {
      flex-direction: column;
      gap: 1.5rem;
    }

    #search .pagefind-ui__filter-panel {
      min-width: 100%;
    }
  }
</style>
